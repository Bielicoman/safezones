<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
	Version="7.0"
	ExtensionBundleId="com.alexascencio.safezones"
	ExtensionBundleVersion="1.0.0"
	ExtensionBundleName="Safe Zones"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
	<ExtensionList>
		<Extension Id="com.alexascencio.safezones.panel" Version="1.0.0" />
		<Extension Id="com.alexascencio.safezones.studio" Version="1.0.0" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="PPRO" Version="[24.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="11.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<!-- 1. Painel Principal Acoplável no Premiere -->
		<Extension Id="com.alexascencio.safezones.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./jsx/SafeZones.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Safe Zones</Menu>
					<Geometry>
						<Size><Height>540</Height><Width>320</Width></Size>
						<MinSize><Height>180</Height><Width>200</Width></MinSize>
						<MaxSize><Height>1600</Height><Width>1200</Width></MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>

		<!-- 2. Painel Studio Pro do Safe Zones -->
		<Extension Id="com.alexascencio.safezones.studio">
			<DispatchInfo>
				<Resources>
					<MainPath>./studio.html</MainPath>
					<ScriptPath>./jsx/SafeZones.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Safe Zones Studio</Menu>
					<Geometry>
						<Size><Height>720</Height><Width>960</Width></Size>
						<MinSize><Height>400</Height><Width>550</Width></MinSize>
						<MaxSize><Height>2160</Height><Width>3840</Width></MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
